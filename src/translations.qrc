        <file alias="zh_CN">lubuntu-update_zh_CN.qm</file>
        <file alias="eu">lubuntu-update_eu.qm</file>
        <file alias="gl">lubuntu-update_gl.qm</file>
        <file alias="fr_FR">lubuntu-update_fr_FR.qm</file>
    </qresource>
</RCC>
